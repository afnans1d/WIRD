import { getTodayDateKey, type SessionProgress, type UserPreferencesState } from './storage';

export interface PushCapabilities {
  isSupported: boolean;
  isIOS: boolean;
  isStandalone: boolean;
  isInsideIframe: boolean;
  requiresIOSHomeScreenInstall: boolean;
  permission: NotificationPermission | 'unsupported';
  platformLabel: string;
}

export interface DeliveryAuditItem {
  id: string;
  period: 'morning' | 'evening' | 'test';
  dateKey: string;
  status: 'sent' | 'failed' | 'expired_removed' | 'skipped_completed' | 'skipped_quiet_hours';
  statusCode?: number;
  errorMessage?: string;
  createdAt: string;
}

const OPT_OUT_KEY = 'wird_push_opted_out_v1';
const LOCAL_ACTIVE_KEY = 'wird_local_push_active_v1';
const LOCAL_NOTIFIED_KEY = 'wird_local_notified_v1';
const LOCAL_DELIVERIES_KEY = 'wird_local_deliveries_v1';

let backendCheckCache: { available: boolean; checkedAt: number } | null = null;

async function isPushBackendAvailable(): Promise<boolean> {
  if (typeof window === 'undefined') return false;
  if (backendCheckCache && Date.now() - backendCheckCache.checkedAt < 30_000) {
    return backendCheckCache.available;
  }
  try {
    const res = await fetch('/api/push/vapid-public-key', { cache: 'no-store' });
    const contentType = res.headers.get('content-type') || '';
    const available = res.ok && contentType.includes('application/json');
    backendCheckCache = { available, checkedAt: Date.now() };
    return available;
  } catch {
    backendCheckCache = { available: false, checkedAt: Date.now() };
    return false;
  }
}

function isPushOptedOut(): boolean {
  try {
    return localStorage.getItem(OPT_OUT_KEY) === '1';
  } catch {
    return false;
  }
}

function setPushOptedOut(optedOut: boolean): void {
  try {
    if (optedOut) {
      localStorage.setItem(OPT_OUT_KEY, '1');
      localStorage.removeItem(LOCAL_ACTIVE_KEY);
    } else {
      localStorage.removeItem(OPT_OUT_KEY);
      localStorage.setItem(LOCAL_ACTIVE_KEY, '1');
    }
  } catch {
    // Ignore storage issues
  }
}

function isLocalPushActivated(): boolean {
  try {
    return localStorage.getItem(LOCAL_ACTIVE_KEY) === '1';
  } catch {
    return false;
  }
}

function loadLocalDeliveries(): DeliveryAuditItem[] {
  try {
    const raw = localStorage.getItem(LOCAL_DELIVERIES_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? (parsed as DeliveryAuditItem[]) : [];
  } catch {
    return [];
  }
}

function appendLocalDelivery(item: DeliveryAuditItem): void {
  try {
    const existing = loadLocalDeliveries();
    const next = [item, ...existing].slice(0, 15);
    localStorage.setItem(LOCAL_DELIVERIES_KEY, JSON.stringify(next));
  } catch {
    // Ignore
  }
}

export function detectPushCapabilities(): PushCapabilities {
  if (typeof window === 'undefined' || typeof navigator === 'undefined') {
    return {
      isSupported: false,
      isIOS: false,
      isStandalone: false,
      isInsideIframe: false,
      requiresIOSHomeScreenInstall: false,
      permission: 'unsupported',
      platformLabel: 'غير معروف',
    };
  }

  const ua = navigator.userAgent.toLowerCase();
  const isIOS =
    /iphone|ipad|ipod/.test(ua) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isMac = /macintosh|mac os x/.test(ua) && !isIOS;
  const isAndroid = /android/.test(ua);

  const isStandalone =
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as unknown as { standalone?: boolean }).standalone === true;

  let isInsideIframe = false;
  try {
    isInsideIframe = window.self !== window.top;
  } catch {
    isInsideIframe = true;
  }

  const hasServiceWorker = 'serviceWorker' in navigator;
  const hasNotification = 'Notification' in window;

  // On iOS/iPadOS, web notifications only work when opened from Home Screen (iOS 16.4+)
  const requiresIOSHomeScreenInstall = isIOS && !isStandalone;
  const isSupported = hasServiceWorker && hasNotification && !requiresIOSHomeScreenInstall;

  let platformLabel = 'متصفح سطح المكتب';
  if (isIOS) platformLabel = isStandalone ? 'iOS (تطبيق الشاشة الرئيسية)' : 'iOS Safari';
  else if (isAndroid) platformLabel = isStandalone ? 'Android (تطبيق مثبت)' : 'Android Chrome';
  else if (isMac) platformLabel = /safari/.test(ua) && !/chrome/.test(ua) ? 'macOS Safari' : 'macOS Chrome';

  return {
    isSupported,
    isIOS,
    isStandalone,
    isInsideIframe,
    requiresIOSHomeScreenInstall,
    permission: hasNotification ? Notification.permission : 'unsupported',
    platformLabel,
  };
}

function urlBase64ToUint8Array(base64String: string): Uint8Array<ArrayBuffer> {
  const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  const rawData = window.atob(base64);
  const buffer = new ArrayBuffer(rawData.length);
  const outputArray = new Uint8Array(buffer);
  for (let i = 0; i < rawData.length; ++i) {
    outputArray[i] = rawData.charCodeAt(i);
  }
  return outputArray;
}

function arrayBufferToBase64Url(buffer: ArrayBuffer): string {
  const bytes = new Uint8Array(buffer);
  let binary = '';
  for (let i = 0; i < bytes.byteLength; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function doesSubscriptionMatchServerKey(
  subscription: PushSubscription,
  serverPublicKey: string
): boolean {
  const existingKey = subscription.options?.applicationServerKey;
  if (!existingKey) return false;
  try {
    const existingBase64Url = arrayBufferToBase64Url(existingKey);
    const normalizedServerKey = serverPublicKey.trim().replace(/=+$/, '');
    return existingBase64Url === normalizedServerKey;
  } catch {
    return false;
  }
}

async function getReadyServiceWorkerRegistration(): Promise<ServiceWorkerRegistration> {
  if (!('serviceWorker' in navigator)) {
    throw new Error('المتصفح لا يدعم مشغّل الخدمات (Service Worker).');
  }

  let reg = await navigator.serviceWorker.getRegistration();
  if (!reg) {
    const swUrl = import.meta.env.DEV ? '/dev-sw.js?dev-sw' : '/sw.js';
    reg = await navigator.serviceWorker.register(swUrl, {
      scope: '/',
      type: import.meta.env.DEV ? 'module' : 'classic',
    });
  }

  const readyReg = await Promise.race<ServiceWorkerRegistration>([
    navigator.serviceWorker.ready,
    new Promise<ServiceWorkerRegistration>((_, reject) =>
      window.setTimeout(
        () => reject(new Error('استغرق تجهيز مشغّل الإشعارات وقتاً أطول من المعتاد، حاول تحديث الصفحة.')),
        8000
      )
    ),
  ]);

  return readyReg || reg;
}

export async function syncScheduleToServiceWorker(
  prefs: UserPreferencesState,
  sessions?: Record<'morning' | 'evening', SessionProgress | null>
): Promise<void> {
  if (typeof navigator === 'undefined' || !('serviceWorker' in navigator)) return;
  try {
    const reg = await navigator.serviceWorker.getRegistration();
    const worker = reg?.active || navigator.serviceWorker.controller;
    if (worker) {
      worker.postMessage({
        type: 'WIRD_SYNC_SCHEDULE',
        schedule: {
          morningEnabled: prefs.morningEnabled,
          eveningEnabled: prefs.eveningEnabled,
          morningTime: prefs.morningTime,
          eveningTime: prefs.eveningTime,
          timezone: prefs.timezone,
          quietHoursEnabled: prefs.quietHoursEnabled,
          quietHoursStart: prefs.quietHoursStart,
          quietHoursEnd: prefs.quietHoursEnd,
          completedMorningDate: sessions?.morning?.isCompleted ? sessions.morning.dateKey : undefined,
          completedEveningDate: sessions?.evening?.isCompleted ? sessions.evening.dateKey : undefined,
        },
      });
    }

    // Register Periodic Background Sync when supported (e.g., Android Chrome PWA on Firebase Hosting)
    const periodicSync = (
      reg as unknown as {
        periodicSync?: { register: (tag: string, opts: { minInterval: number }) => Promise<void> };
      }
    )?.periodicSync;
    if (periodicSync && Notification.permission === 'granted') {
      await periodicSync
        .register('wird-adhkar-check', { minInterval: 15 * 60 * 1000 })
        .catch(() => {});
    }
  } catch {
    // Gracefully ignored on browsers without periodicSync
  }
}

async function acquireMatchingPushSubscription(
  registration: ServiceWorkerRegistration,
  publicKey: string,
  forceRefresh = false
): Promise<PushSubscription> {
  let subscription = await registration.pushManager.getSubscription();

  if (subscription && (forceRefresh || !doesSubscriptionMatchServerKey(subscription, publicKey))) {
    try {
      await subscription.unsubscribe();
    } catch {
      // Proceed to re-subscribe cleanly
    }
    subscription = null;
  }

  if (!subscription) {
    const appServerKey = urlBase64ToUint8Array(publicKey);
    try {
      subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: appServerKey,
      });
    } catch (err) {
      if (err instanceof DOMException && err.name === 'InvalidStateError') {
        const stale = await registration.pushManager.getSubscription();
        if (stale) {
          await stale.unsubscribe().catch(() => {});
        }
        subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: appServerKey,
        });
      } else {
        throw err;
      }
    }
  }

  return subscription;
}

async function postSubscriptionToServer(
  deviceId: string,
  prefs: UserPreferencesState,
  platformLabel: string,
  subscription: PushSubscription,
  userId?: string
): Promise<void> {
  const subJson = subscription.toJSON();
  if (!subJson?.endpoint || !subJson?.keys?.p256dh || !subJson?.keys?.auth) {
    throw new Error('تعذر قراءة مفاتيح الاشتراك من المتصفح.');
  }

  const res = await fetch('/api/push/subscribe', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      deviceId,
      userId: userId || undefined,
      platform: platformLabel,
      timezone: prefs.timezone,
      morningEnabled: prefs.morningEnabled,
      eveningEnabled: prefs.eveningEnabled,
      morningTime: prefs.morningTime,
      eveningTime: prefs.eveningTime,
      quietHoursEnabled: prefs.quietHoursEnabled,
      quietHoursStart: prefs.quietHoursStart,
      quietHoursEnd: prefs.quietHoursEnd,
      subscription: subJson,
    }),
  });

  if (!res.ok) {
    const errData = (await res.json().catch(() => ({}))) as { error?: string };
    throw new Error(errData.error || 'فشل تسجيل الاشتراك في الخادم');
  }
}

async function dispatchNativeSwNotification(
  period: 'morning' | 'evening',
  isTest = false
): Promise<boolean> {
  const title = period === 'morning' ? 'وِرد · أذكار الصباح' : 'وِرد · أذكار المساء';
  const body =
    period === 'morning'
      ? 'صباح الخير ☀️ حان وقت أذكار الصباح حفظك الله'
      : 'مساء الخير 🌙 حان وقت أذكار المساء حفظك الله';
  const tag = isTest ? `wird-test-${period}` : `wird-${period}-reminder`;

  try {
    const reg = await getReadyServiceWorkerRegistration();
    await reg.showNotification(title, {
      body,
      icon: '/pwa-192x192.png',
      badge: '/pwa-192x192.png',
      dir: 'rtl',
      lang: 'ar',
      tag,
      data: { url: `/?session=${period}`, period },
    });
    return true;
  } catch {
    try {
      new Notification(title, {
        body,
        icon: '/pwa-192x192.png',
        dir: 'rtl',
        lang: 'ar',
        tag,
      });
      return true;
    } catch {
      return false;
    }
  }
}

export async function subscribeDeviceToPush(
  deviceId: string,
  prefs: UserPreferencesState,
  userId?: string,
  options?: { forceRefresh?: boolean; skipPermissionPrompt?: boolean }
): Promise<{ ok: boolean; error?: string }> {
  const caps = detectPushCapabilities();

  if (caps.requiresIOSHomeScreenInstall) {
    return {
      ok: false,
      error: 'على أجهزة iPhone و iPad يجب إضافة تطبيق وِرد إلى الشاشة الرئيسية أولاً عبر Safari لتفعيل الإشعارات.',
    };
  }

  if (!('serviceWorker' in navigator) || !('Notification' in window)) {
    return {
      ok: false,
      error: 'هذا المتصفح لا يدعم إشعارات الويب.',
    };
  }

  const permission = options?.skipPermissionPrompt
    ? Notification.permission
    : await Notification.requestPermission();

  if (permission !== 'granted') {
    if (caps.isInsideIframe) {
      return {
        ok: false,
        error: 'يمنع المتصفح طلب إذن الإشعارات داخل نافذة المعاينة المدمجة. افتح التطبيق على رابط Firebase مباشرة ثم فعّل الإشعارات.',
      };
    }
    return {
      ok: false,
      error:
        permission === 'denied'
          ? 'تم حظر إذن الإشعارات من إعدادات المتصفح. يمكنك السماح بها يدوياً من إعدادات الموقع.'
          : 'لم يتم منح إذن الإشعارات.',
    };
  }

  try {
    setPushOptedOut(false);
    const registration = await getReadyServiceWorkerRegistration();
    await syncScheduleToServiceWorker(prefs);

    // If an Express/Cloud push backend is attached, also register Web Push subscription seamlessly.
    // On static Firebase Hosting, PWA local & Periodic Sync notifications work directly with zero errors!
    const backendUp = await isPushBackendAvailable();
    if (backendUp && 'PushManager' in window) {
      try {
        const keyRes = await fetch('/api/push/vapid-public-key', { cache: 'no-store' });
        if (keyRes.ok) {
          const { publicKey } = (await keyRes.json()) as { publicKey: string };
          const subscription = await acquireMatchingPushSubscription(
            registration,
            publicKey,
            Boolean(options?.forceRefresh)
          );
          await postSubscriptionToServer(deviceId, prefs, caps.platformLabel, subscription, userId);
        }
      } catch {
        // Browser push relay blocked or offline — PWA notifications stay active with zero user error
      }
    }

    return { ok: true };
  } catch (err) {
    return {
      ok: false,
      error: err instanceof Error ? err.message : 'حدث خطأ أثناء تفعيل الإشعارات',
    };
  }
}

export async function ensurePushSubscriptionSynced(
  deviceId: string,
  prefs: UserPreferencesState,
  userId?: string,
  forceServerSync = false
): Promise<boolean> {
  const caps = detectPushCapabilities();
  if (!caps.isSupported || caps.permission !== 'granted' || isPushOptedOut()) {
    return false;
  }

  setPushOptedOut(false);
  await syncScheduleToServiceWorker(prefs);

  const backendUp = await isPushBackendAvailable();
  if (!backendUp || !('PushManager' in window)) {
    return true;
  }

  try {
    const [audit, keyRes, registration] = await Promise.all([
      forceServerSync
        ? Promise.resolve({ hasActiveSubscription: false, deliveries: [] })
        : fetchPushAudit(deviceId),
      fetch('/api/push/vapid-public-key', { cache: 'no-store' }),
      getReadyServiceWorkerRegistration(),
    ]);

    if (!keyRes.ok) return true;
    const { publicKey } = (await keyRes.json()) as { publicKey: string };

    const existingSub = await registration.pushManager.getSubscription();
    const keyMatches = existingSub ? doesSubscriptionMatchServerKey(existingSub, publicKey) : false;

    if (audit.hasActiveSubscription && keyMatches && !forceServerSync) {
      return true;
    }

    const subscription = await acquireMatchingPushSubscription(registration, publicKey, !keyMatches);
    await postSubscriptionToServer(deviceId, prefs, caps.platformLabel, subscription, userId);
    return true;
  } catch {
    return true;
  }
}

export async function syncPushPreferences(
  deviceId: string,
  prefs: UserPreferencesState,
  userId?: string
): Promise<void> {
  await syncScheduleToServiceWorker(prefs);

  const backendUp = await isPushBackendAvailable();
  if (!backendUp) return;

  try {
    const res = await fetch('/api/push/preferences', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        deviceId,
        timezone: prefs.timezone,
        morningEnabled: prefs.morningEnabled,
        eveningEnabled: prefs.eveningEnabled,
        morningTime: prefs.morningTime,
        eveningTime: prefs.eveningTime,
        quietHoursEnabled: prefs.quietHoursEnabled,
        quietHoursStart: prefs.quietHoursStart,
        quietHoursEnd: prefs.quietHoursEnd,
      }),
    });

    if (res.status === 404) {
      await ensurePushSubscriptionSynced(deviceId, prefs, userId, true);
    }
  } catch {
    // Offline gracefully ignored
  }
}

export async function syncSessionCompletionToServer(
  deviceId: string,
  period: 'morning' | 'evening',
  dateKey: string,
  completed: boolean
): Promise<void> {
  const backendUp = await isPushBackendAvailable();
  if (!backendUp) return;

  try {
    await fetch('/api/push/session-status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deviceId, period, dateKey, completed }),
    });
  } catch {
    // Offline gracefully ignored
  }
}

export async function sendTestPush(
  deviceId: string,
  period: 'morning' | 'evening',
  prefs?: UserPreferencesState,
  userId?: string
): Promise<{ ok: boolean; error?: string }> {
  if (typeof window === 'undefined' || !('Notification' in window)) {
    return { ok: false, error: 'هذا المتصفح لا يدعم الإشعارات.' };
  }

  if (Notification.permission !== 'granted' && prefs) {
    const activated = await subscribeDeviceToPush(deviceId, prefs, userId);
    if (!activated.ok) return activated;
  }

  const backendUp = await isPushBackendAvailable();
  if (backendUp) {
    const attemptSend = async () => {
      const res = await fetch('/api/push/send-test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deviceId, period }),
      });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        needsResubscribe?: boolean;
      };
      return { res, data };
    };

    try {
      let { res, data } = await attemptSend();

      if (!res.ok && (res.status === 404 || res.status === 410 || data.needsResubscribe) && prefs) {
        const healed = await subscribeDeviceToPush(deviceId, prefs, userId, {
          forceRefresh: res.status === 410 || Boolean(data.needsResubscribe),
          skipPermissionPrompt: Notification.permission === 'granted',
        });
        if (healed.ok) {
          ({ res, data } = await attemptSend());
        }
      }

      if (res.ok) {
        return { ok: true };
      }
    } catch {
      // Fall through cleanly to native Service Worker notification
    }
  }

  // Static Firebase Hosting / offline / direct PWA notification delivery
  const shown = await dispatchNativeSwNotification(period, true);
  if (shown) {
    appendLocalDelivery({
      id: `local_${Date.now()}`,
      period: 'test',
      dateKey: getTodayDateKey(prefs?.timezone),
      status: 'sent',
      statusCode: 200,
      createdAt: new Date().toISOString(),
    });
    return { ok: true };
  }

  return {
    ok: false,
    error: 'تعذر عرض الإشعار. تأكد من السماح بالإشعارات في إعدادات المتصفح.',
  };
}

export async function unsubscribeDevicePush(deviceId: string): Promise<void> {
  setPushOptedOut(true);
  try {
    if ('serviceWorker' in navigator && 'PushManager' in window) {
      const reg = await navigator.serviceWorker.getRegistration();
      const sub = await reg?.pushManager.getSubscription();
      if (sub) await sub.unsubscribe();
    }
  } catch {
    // Ignore
  }
  const backendUp = await isPushBackendAvailable();
  if (backendUp) {
    await fetch('/api/push/unsubscribe', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deviceId }),
    }).catch(() => {});
  }
}

export async function fetchPushAudit(deviceId: string): Promise<{
  hasActiveSubscription: boolean;
  deliveries: DeliveryAuditItem[];
}> {
  const caps = detectPushCapabilities();
  const localActive = caps.permission === 'granted' && isLocalPushActivated() && !isPushOptedOut();
  const localDeliveries = loadLocalDeliveries();

  const backendUp = await isPushBackendAvailable();
  if (!backendUp) {
    return {
      hasActiveSubscription: localActive,
      deliveries: localDeliveries,
    };
  }

  try {
    const res = await fetch(`/api/push/deliveries?deviceId=${encodeURIComponent(deviceId)}`, {
      cache: 'no-store',
    });
    if (!res.ok) {
      return { hasActiveSubscription: localActive, deliveries: localDeliveries };
    }
    const serverAudit = (await res.json()) as {
      hasActiveSubscription: boolean;
      deliveries: DeliveryAuditItem[];
    };
    const merged = [...serverAudit.deliveries, ...localDeliveries]
      .sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1))
      .slice(0, 15);

    return {
      hasActiveSubscription: serverAudit.hasActiveSubscription || localActive,
      deliveries: merged,
    };
  } catch {
    return { hasActiveSubscription: localActive, deliveries: localDeliveries };
  }
}

function getLocalHHMM(timezone?: string): string {
  try {
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: timezone || Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const parts = formatter.formatToParts(new Date());
    const h = parts.find((p) => p.type === 'hour')?.value || '00';
    const m = parts.find((p) => p.type === 'minute')?.value || '00';
    return `${h === '24' ? '00' : h}:${m}`;
  } catch {
    const now = new Date();
    return `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  }
}

function hhmmToMinutes(hhmm: string): number {
  const [h, m] = hhmm.split(':').map(Number);
  return (h || 0) * 60 + (m || 0);
}

function isQuietNow(nowHHMM: string, start: string, end: string): boolean {
  const cur = hhmmToMinutes(nowHHMM);
  const s = hhmmToMinutes(start);
  const e = hhmmToMinutes(end);
  if (s === e) return false;
  return s < e ? cur >= s && cur < e : cur >= s || cur < e;
}

export async function checkAndFireLocalDueReminder(
  prefs: UserPreferencesState,
  sessions: Record<'morning' | 'evening', SessionProgress | null>
): Promise<void> {
  if (typeof window === 'undefined' || !('Notification' in window) || Notification.permission !== 'granted') {
    return;
  }
  if (isPushOptedOut()) return;

  await syncScheduleToServiceWorker(prefs, sessions);

  const dateKey = getTodayDateKey(prefs.timezone);
  const nowHHMM = getLocalHHMM(prefs.timezone);
  if (prefs.quietHoursEnabled && isQuietNow(nowHHMM, prefs.quietHoursStart, prefs.quietHoursEnd)) {
    return;
  }

  let notifiedMap: Record<string, boolean> = {};
  try {
    notifiedMap = JSON.parse(localStorage.getItem(LOCAL_NOTIFIED_KEY) || '{}') as Record<string, boolean>;
  } catch {
    notifiedMap = {};
  }

  const candidates: Array<{
    period: 'morning' | 'evening';
    enabled: boolean;
    time: string;
  }> = [
    { period: 'morning', enabled: prefs.morningEnabled, time: prefs.morningTime },
    { period: 'evening', enabled: prefs.eveningEnabled, time: prefs.eveningTime },
  ];

  const nowMin = hhmmToMinutes(nowHHMM);
  for (const item of candidates) {
    if (!item.enabled) continue;
    const isCompletedToday =
      sessions[item.period]?.dateKey === dateKey && Boolean(sessions[item.period]?.isCompleted);
    if (isCompletedToday) continue;

    const key = `${dateKey}:${item.period}`;
    if (notifiedMap[key]) continue;

    const diff = Math.abs(nowMin - hhmmToMinutes(item.time));
    if (diff > 2 && 1440 - diff > 2) continue;

    notifiedMap[key] = true;
    try {
      localStorage.setItem(LOCAL_NOTIFIED_KEY, JSON.stringify(notifiedMap));
    } catch {
      // Ignore
    }

    const shown = await dispatchNativeSwNotification(item.period, false);
    if (shown) {
      appendLocalDelivery({
        id: `local_${Date.now()}_${item.period}`,
        period: item.period,
        dateKey,
        status: 'sent',
        statusCode: 200,
        createdAt: new Date().toISOString(),
      });
    }
  }
}
