# GEMINI_API_KEY: Optional Gemini AI API key (unused unless AI features are explicitly enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VAPID keys for real Web Push notifications (generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# CRON_SECRET: Bearer token protecting the server-side scheduled reminder processor (/api/notifications/process-due)
CRON_SECRET=
